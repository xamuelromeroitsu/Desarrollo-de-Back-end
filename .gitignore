# Ignorar dependencias de Node.js
node_modules/

# Ignorar archivos del entorno y datos sensibles
.env

# Ignorar manifiesto de proyecto (si aplica a tu caso de uso)
package.json

# Ignorar todos los registros / logs
*.log

# Ignorar archivos .txt dentro de la carpeta doc/
doc/*.txt

# Excepción: NO ignorar este archivo específico aunque esté dentro de doc/
!doc/importante.txt