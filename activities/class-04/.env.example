# ==============================================================================
# BASE DE DATOS (Supabase Connection Pooler / Direct Connection)
# ==============================================================================
# Reemplaza [TU_CONTRASEÑA] con la contraseña real de tu base de datos en Supabase.
# 
# NOTA SOBRE LOS PUERTOS:
# - Puerto 5432: Modo Session / Direct Connection
# - Puerto 6543: Modo Transaction (Recomendado para Serverless o múltiples conexiones rápidas)

# Cadena de conexión completa (útil para ORMs como Prisma, Drizzle, Sequelize, SQLAlchemy, etc.):
DATABASE_URL=postgresql://postgres.toixeijphpicambsyada:[TU_CONTRASEÑA]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Parámetros desglosados (por si tu backend o herramientas como SQLTools los piden por separado):
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.toixeijphpicambsyada
DB_PASSWORD=tu_contraseña_aqui










#este es ejemplo nro 2 de archivo .env para el proyecto con el motor de postgresql de supabase.
# SERVER & PORT CONFIGURATION
PORT=3000
NODE_ENV=development

# SUPABASE CONFIGURATION
# Obtén estas llaves en Project Settings > API de tu panel de Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# DATABASE DIRECT CONNECTION / POOLER (Para SQLTools o Migraciones)
# Obtén estos datos en Project Settings > Database
DB_HOST=db.tu-proyecto.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui



## Configuración del Entorno

1. Clona el repositorio.
2. Copia el archivo de ejemplo y crea tu archivo local:
   ```bash
   cp .env.example .env