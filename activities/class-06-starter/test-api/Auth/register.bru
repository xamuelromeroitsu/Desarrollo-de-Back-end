meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "nuevo.requester@gmail.com",
    "password": "una frase de prueba larga"
  }
}

// Prueba: el alta pública crea un usuario con rol requester.
// Respuesta esperada: 201 con role "requester" y SIN passwordHash.
// Ojo: no intentar enviar role (el servidor lo controla → 400 SERVER_CONTROLLED_FIELD).