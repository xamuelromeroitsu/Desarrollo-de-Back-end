# =====================================================================
# EN: Environment template for the Yoghurt Store API. Copy this file to
# .env and fill in REAL values (never commit .env). In Supabase, the
# connection string requires sslmode=require; a local PostgreSQL works
# without that suffix.
# ES: Plantilla de entorno para la API de Tienda de Yogures. Copia este
# archivo a .env y completa con valores REALES (nunca commitees .env).
# En Supabase la cadena de conexión requiere sslmode=require; un
# PostgreSQL local funciona sin ese sufijo.
# =====================================================================

# EN: full PostgreSQL connection string on one line.
# ES: cadena de conexión PostgreSQL completa en una línea.
DATABASE_URL=postgresql://user:password@host:5432/ecommerce_db?sslmode=require

# EN: secret used to sign access tokens (HS256). Generate with: node scripts/generate-secret.js
# ES: secreto usado para firmar tokens de acceso (HS256). Genéralo con: node scripts/generate-secret.js
JWT_SECRET=change-me

# EN: HTTP port where the API listens (default 3000).
# ES: puerto HTTP donde escucha la API (default 3000).
PORT=3000